{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/resume/:path*",
      "destination": "/resume/:path*"
    },
    {
      "source": "/certificates/:path*",
      "destination": "/certificates/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
